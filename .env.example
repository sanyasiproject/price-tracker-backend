# MongoDB (use MongoDB Atlas free tier for production)
MONGODB_URI=mongodb://localhost:27017/price-tracker

# JWT
JWT_SECRET=your_jwt_secret_change_this

# Mail SMTP (pick any provider below)
#
# Gmail:       MAIL_HOST=smtp.gmail.com  MAIL_PORT=587  MAIL_USER=you@gmail.com  MAIL_PASS=app-password
# Brevo:       MAIL_HOST=smtp-relay.brevo.com  MAIL_PORT=587  MAIL_USER=your-login  MAIL_PASS=your-smtp-key
# Outlook:     MAIL_HOST=smtp.office365.com  MAIL_PORT=587  MAIL_USER=you@outlook.com  MAIL_PASS=your-password
#
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=

# App
PORT=5001
# For production, set to your Vercel frontend URL
CLIENT_URL=http://localhost:5173
