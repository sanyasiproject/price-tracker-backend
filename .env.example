# MongoDB (use MongoDB Atlas free tier for production)
MONGODB_URI=mongodb://localhost:27017/price-tracker

# JWT
JWT_SECRET=your_jwt_secret_change_this

# Gmail SMTP (for sending price alert notifications)
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# App
PORT=5001
# For production, set to your Vercel frontend URL (comma-separated for multiple)
CLIENT_URL=http://localhost:5173
